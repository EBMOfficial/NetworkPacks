{
  "type": "minecraft:multi_action",
  "title": "Bedroom Control Module",
  "can_close_with_escape": true,
  "exit_action": {
    "label": {
      "text": "Exit Bedroom Control",
      "color": "red"
    }
  },
  "columns": 3,
  "actions": [
    {
      "label": "Bedroom Lights",
      "width": 100,
      "action": {
        "type": "minecraft:run_command",
        "command": "dialog show @p ebmhousetech:bedroomcontrols"
      }
    },
    {
      "label": {
        "text": "On",
        "color": "green"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "function ebmhousetech:ebmbedroomlightson"
      }
    },
    {
      "label": {
        "text": "Off",
        "color": "red"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "function ebmhousetech:ebmbedroomlightsoff"
      }
    },
    {
