{
  "type": "minecraft:multi_action",
  "title": "Studio Control Module",
  "body": {
    "type": "minecraft:plain_message",
    "contents": {
      "text": "\"Maybe designing all my tech solutions was a good decision in the end.\" - EBMOfficial \n \n Music, lights as well as lockdown mode functionalities can all be controlled through this menu.",
      "color": "green"
    },
    "width": 500
  },
  "can_close_with_escape": true,
  "exit_action": {
    "label": {
      "text": "Exit Music Control",
      "color": "red"
    }
  },
  "columns": 1,
