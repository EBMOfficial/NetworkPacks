              "action": {
                "type": "minecraft:run_command",
                "command": "function ebmhousetech:tvon"
              }
            },
            {
              "label": {
                "text": "Off",
                "color": "red"
              },
              "action": {
                "type": "minecraft:run_command",
                "command": "function ebmhousetech:tvoff"
              }
            },
            {
              "label": "EBMtv",
              "action": {
                "type": "minecraft:run_command",
                "command": "function ebmhousetech:tvebmtv"
