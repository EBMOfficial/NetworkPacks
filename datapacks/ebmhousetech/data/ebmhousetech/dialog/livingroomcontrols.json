{
  "type": "minecraft:multi_action",
  "title": "Living Room Controls",
  "can_close_with_escape": true,
  "exit_action": {
    "label": {
      "text": "Exit Living Room Control",
      "color": "red"
    }
  },
  "columns": 1,
  "actions": [
    {
      "label": "Light Controls",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": {
          "type": "minecraft:multi_action",
          "title": "Light Controls",
          "can_close_with_escape": true,
          "exit_action": {
            "label": {
              "text": "Exit Light Control",
              "color": "red"
            },
            "action": {
              "type": "minecraft:run_command",
              "command": "dialog show @p ebmhousetech:livingroomcontrols"
            }
          },
          "actions": [
            {
              "label": {
                "text": "On",
                "color": "green"
              },
              "width": 50,
              "action": {
                "type": "minecraft:run_command",
                "command": "function ebmhousetech:ebmlivingroomlightson"
              }
            },
            {
              "label": {
                "text": "Off",
                "color": "red"
              },
              "width": 50,
              "action": {
                "type": "minecraft:run_command",
                "command": "function ebmhousetech:ebmlivingroomlightsoff"
              }
            }
          ]
        }
      }
    },
    {
      "label": "TV Controls",
      "action": {
        "type": "minecraft:show_dialog",
