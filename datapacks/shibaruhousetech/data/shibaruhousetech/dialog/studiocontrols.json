{
  "type": "minecraft:multi_action",
  "title": "Studio Control Module",
  "body": {
    "type": "minecraft:plain_message",
    "contents": {
      "text": "\"Music and light functionalities can all be controlled through this menu.",
      "color": "green"
    },
    "width": 500
  },
  "can_close_with_escape": true,
  "exit_action": {
    "label": {
      "text": "Exit Music Control",
      "color": "red"
    }
  },
  "columns": 1,
  "actions": [
    {
      "label": "Light Controls",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": {
          "type": "minecraft:multi_action",
          "title": "Light Controls",
          "can_close_with_escape": true,
          "exit_action": {
            "label": {
              "text": "Exit Light Control",
              "color": "red"
            },
            "action": {
              "type": "minecraft:run_command",
              "command": "dialog show @p shibaruhousetech:studiocontrols"
            }
          },
          "actions": [
            {
              "label": {
                "text": "On",
                "color": "green"
              },
              "width": 50,
              "action": {
                "type": "minecraft:run_command",
                "command": "function shibaruhousetech:studiolightson"
              }
            },
            {
              "label": {
                "text": "Off",
                "color": "red"
              },
              "width": 50,
              "action": {
                "type": "minecraft:run_command",
                "command": "function shibaruhousetech:studiolightsoff"
              }
            }
          ]
        }
      }
    },
    {
      "label": "Music Controls",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": {
          "type": "minecraft:multi_action",
          "title": "Music Controls",
          "body": {
            "type": "minecraft:plain_message",
            "contents": {
              "text": "In the mood to jam out? CHROMA Inc. has you covered with it's state-of-the-art DUO music system!",
              "color": "green"
            }
          },
          "inputs": [
            {
              "type": "minecraft:number_range",
              "key": "volmax",
              "label": "Volume",
              "start": 0.1,
              "end": 5,
              "step": 0.1,
              "initial": 0.1
            },
            {
              "type": "minecraft:number_range",
              "key": "pitch",
              "label": "Pitch",
              "start": 0.5,
              "end": 2,
              "step": 0.1,
              "initial": 1
            }
          ],
          "can_close_with_escape": true,
          "exit_action": {
            "label": {
              "text": "Exit Music Control",
              "color": "red"
            },
            "action": {
              "type": "minecraft:run_command",
              "command": "dialog show @p shibaruhousetech:studiocontrols"
            }
          },
          "columns": 2,
          "actions": [
            {
              "label": {
                "text": "Stop Player",
                "color": "red"
              },
              "width": 200,
              "action": {
