{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Apt 3 Music Control"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "In the mood to jam out? EBM Industries has you covered with it's state-of-the-art Aura music system!",
        "color": "green",
        "bold": false
      }
    }
  ],
  "inputs": [
    {
      "type": "minecraft:number_range",
      "key": "volmax",
      "label": "Volume",
      "start": 0.1,
      "end": 5,
      "step": 0.1,
      "initial": 0.1
    },
    {
      "type": "minecraft:number_range",
      "key": "pitch",
      "label": "Pitch",
      "start": 0.5,
      "end": 2,
      "step": 0.1,
      "initial": 1
    }
  ],
  "can_close_with_escape": true,
  "exit_action": {
    "label": {
      "text": "Exit Music Control",
      "color": "red"
    }
  },
  "columns": 2,
  "actions": [
    {
      "label": {
        "text": "Stop Player",
        "color": "red"
      },
      "width": 200,
      "action": {
        "type": "minecraft:run_command",
        "command": "function aureliacitylights:odeszaapt3ebmsystemstopplayer"
      }
    },
    {
      "label": "The Weeknd - Timeless (ft. Playboi Carti)",
      "width": 200,
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "function aureliacitylights:odeszaapt3ebmsystemtimeless {volmax: $(volmax),pitch: $(pitch),volmin:0.1}"
      }
    },
