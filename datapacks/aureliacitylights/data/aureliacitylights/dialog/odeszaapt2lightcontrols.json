{
  "type": "minecraft:multi_action",
  "title": "Apt 2 Light Control Module",
  "can_close_with_escape": true,
  "exit_action": {
    "label": {
      "text": "Exit Light Control",
      "color": "red"
    }
  },
  "columns": 3,
  "actions": [
    {
      "label": "Main",
      "width": 75,
      "action": {
        "type": "minecraft:run_command",
        "command": "dialog show @p aureliacitylights:odeszaapt2lightcontrols"
      }
    },
    {
      "label": {
        "text": "On",
        "color": "green"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "function aureliacitylights:odeszaapt02mainlightson"
